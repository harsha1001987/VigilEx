DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/VigilEx

# Comma-separated list of allowed CORS origins for local development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Signs access tokens. Required: the API will not start without it.
# Generate one per environment and keep it out of version control:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# Access token lifetime in minutes (default 720 = one 12-hour shift).
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# Sign-in / registration attempt limits per client (in-memory, per API process).
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_SECONDS=900
# REGISTER_RATE_LIMIT=5
# REGISTER_RATE_WINDOW_SECONDS=3600
