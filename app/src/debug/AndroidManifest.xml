<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest override. Merged only into debug builds, so this is the
  only build variant that gets cleartext HTTP (and only to the specific dev
  hosts listed in network_security_config.xml) - release builds are untouched.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
