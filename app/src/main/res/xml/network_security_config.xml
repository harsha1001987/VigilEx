<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP only to local development hosts, and only in debug builds
  (see src/debug/AndroidManifest.xml, which is the only place this file is
  referenced). Release builds never see this file, so production traffic
  still requires TLS.

  10.0.2.2  -> the Android Emulator's alias for the host machine's localhost.
  localhost / 127.0.0.1 -> for completeness when testing from the emulator itself.

  10.79.144.153 -> the development PC's current Wi-Fi LAN IP, for testing on
  a physical phone (must match ApiConfig.BASE_URL; update both if the PC's
  IP changes, e.g. after reconnecting to Wi-Fi).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.79.144.153</domain>
    </domain-config>
</network-security-config>
