<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (applied via src/debug/AndroidManifest.xml).

  The analysis server address is configurable in Developer options so a physical phone
  can reach a development server on the local network, whose IP is not known at
  build time. Debug builds therefore allow plain HTTP to any host. Release
  builds do not use this file and keep Android's default (HTTPS only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
