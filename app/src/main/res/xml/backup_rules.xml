<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules (Android 11 and lower). The encrypted sign-in session is
   never backed up: its key lives in this device's Keystore and the session
   must not follow the data to another device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="vigilex_session.xml" />
</full-backup-content>
