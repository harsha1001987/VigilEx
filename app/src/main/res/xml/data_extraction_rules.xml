<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules (Android 12+). The encrypted sign-in
   session is never backed up or transferred; sign in again on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vigilex_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vigilex_session.xml" />
    </device-transfer>
</data-extraction-rules>
